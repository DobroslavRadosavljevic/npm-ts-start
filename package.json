{
  "name": "npm-ts-start",
  "version": "0.0.1",
  "description": "A starter for creating a TypeScript npm package.",
  "keywords": [
    "npm",
    "package",
    "typescript"
  ],
  "homepage": "https://github.com/DobroslavRadosavljevic/npm-ts-start#readme",
  "bugs": {
    "url": "https://github.com/DobroslavRadosavljevic/npm-ts-start/issues"
  },
  "license": "MIT",
  "author": "Dobroslav Radosavljevic <dobroslav.radosavljevic@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DobroslavRadosavljevic/npm-ts-start.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": null
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "bun test",
    "lint": "bun ultracite check",
    "format": "bun ultracite fix",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "check:package": "bunx --bun publint && bunx --bun @arethetypeswrong/cli --pack --profile esm-only .",
    "test:consumer": "node ./scripts/consumer-smoke.mjs",
    "check:all": "bun run lint && bun run typecheck && bun run test && bun run build && bun run check:package && bun run test:consumer",
    "prepare": "husky",
    "prepublishOnly": "bun run check:all",
    "bump": "bumpp --changelog"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@types/bun": "1.3.9",
    "bumpp": "^10.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.28.0",
    "oxlint": "^1.43.0",
    "publint": "^0.3.15",
    "tsdown": "^0.20.3",
    "typescript": "^5.9.3",
    "ultracite": "7.1.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "bun ultracite fix"
    ],
    "*.{json,md,yml,yaml}": [
      "bun ultracite fix"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.9"
}
