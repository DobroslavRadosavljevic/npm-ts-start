{
  "name": "npm-ts-start",
  "version": "0.0.1",
  "description": "A starter for creating a TypeScript npm package.",
  "keywords": [
    "npm",
    "package",
    "typescript"
  ],
  "homepage": "https://github.com/your-org/your-package#readme",
  "bugs": {
    "url": "https://github.com/your-org/your-package/issues"
  },
  "license": "MIT",
  "author": "Your Name <you@example.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/your-package.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": null,
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "bun ultracite check",
    "format": "bun ultracite fix",
    "typecheck": "tsc --noEmit",
    "check:pack": "npm pack --dry-run",
    "check:all": "bun run lint && bun run typecheck && bun run test && bun run build && bun run check:pack",
    "login": "npm login --auth-type=web",
    "logout": "npm logout",
    "whoami": "npm whoami",
    "release:dry": "npm publish --access public --dry-run",
    "release": "npm publish --access public",
    "prepublishOnly": "bun run check:all"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/bun": "1.3.14",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "publint": "^0.3.21",
    "tsdown": "^0.22.9",
    "typescript": "^7.0.2",
    "ultracite": "7.9.4",
    "unplugin-unused": "^0.5.7",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14"
}
